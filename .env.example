# Application
NODE_ENV=development
TZ=America/Bogota
APP_TIMEZONE=America/Bogota

# PostgreSQL 16 + PostGIS
POSTGRES_USER=dps
POSTGRES_PASSWORD=dps
POSTGRES_DB=daily_payment
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dps:dps@localhost:5432/daily_payment

# Redis (BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO local dev)
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=daily-payment
S3_REGION=us-east-1
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=60

# Auth (NestJS — Phase M2)
API_PORT=3001
API_URL=http://localhost:3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Bootstrap admin (pnpm --filter @dps/api bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=admin@daily-payment.local
BOOTSTRAP_ADMIN_PASSWORD=AdminPass123!
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=Sistema

# Web (Next.js — later phases)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Mobile (Flutter collector — emulator → host machine)
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3001/v1
# Physical device on same LAN: http://<your-ip>:3001/v1

# Receipt links
RECEIPT_LINK_TTL_DAYS=90
WEB_PUBLIC_URL=http://localhost:3000

# Push notifications (optional — legacy FCM HTTP API)
# FCM_SERVER_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000
